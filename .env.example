# --- Server ---
# Internal HTTP port (NPM terminates SSL in front)
PORT=8080

# --- Polling ---
# Seconds between metric refreshes pushed via HTMX (10-30s recommended)
POLLING_INTERVAL=15

# --- Service discovery ---
# Comma-separated list of directories to scan for docker-compose.{yml,yaml}
# Each directory is walked recursively up to a depth of 3.
COMPOSE_SCAN_PATH=/srv,/opt/stacks,/docker

# --- Title shown in the UI (optional) ---
DASHBOARD_TITLE=Home Lab Dashboard

# --- Public IP detection ---
# '1' to enable, '0' to disable (avoids outbound HTTP from the LAN)
ENABLE_PUBLIC_IP=1

# --- Logging ---
# One of: debug | info | warn | error
LOG_LEVEL=info
